# BloomTrack Environment Configuration Template
# Copy this file to .env and supply actual values

# Backend Configuration
APP_NAME="BloomTrack API"
DEBUG=false
SECRET_KEY="your-secure-random-secret-key-min-32-chars"
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# PostgreSQL Database Connection
# Local development SQLite fallback: sqlite:///./bloomtrack.db
# Production PostgreSQL format: postgresql://username:password@hostname:5432/dbname
DATABASE_URL="postgresql://bloomtrack_user:your_secure_db_password@localhost:5432/bloomtrack"

# CORS Configuration (comma-separated origins)
ALLOWED_ORIGINS="http://localhost:3000,http://127.0.0.1:8000,https://bloomtrack.onrender.com"

# Notification Services (Optional / Deployment)
FCM_SERVER_KEY=""
APNS_KEY_ID=""
APNS_TEAM_ID=""
